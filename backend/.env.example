# Sports Odds Research Tool — environment variables
#
# The ESPN scoreboard API used in this prototype requires no API key.
# This file exists for future integrations (e.g., a real odds provider).

# Optional: override the ESPN scoreboard URL if needed
# ESPN_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard

# Future: real odds provider API key
# ODDS_API_KEY=your_key_here
